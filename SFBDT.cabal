cabal-version: 3.0
name:          SFBDT
version:       0.1.0.0
synopsis:      An implementation of a bidirectional-style, predicative type system, centered around the capabilities of System F.

description:
  This is a piece of a small sequence of languages which support bidirectional typing.
  It only permits the unit type, which can be composed by using arrow types.
  Universal quantification is allowed as well, and type variables must be monomorphic
  in the sense that they can only be instantiated to a single non-polymorphic type (that is, with no universal quantification)
  Based on Jana Dunfield's and Neelakantan R. Krishnaswami's small example of a typing (for a very simple language) which
  follows Pfenning's recipe for bidirectional typing.

homepage:     https://github.com/LambdaFiend/bidirectional-typing/tree/SFBDT
license:      BSD-3-Clause
license-file: LICENSE
author:       Lambda Fiend
maintainer:   thelambdafiend@gmail.com

--copyright:

category:   Language
build-type: Simple

extra-doc-files:
  CHANGELOG.md
  README.md
  programs/README.md

extra-source-files: default_tests.txt

common warnings
  --ghc-options: 

executable SFBDT
  import:         warnings
  main-is:        Main.hs
  hs-source-dirs: src

  other-modules:
    Display,
    Helper,
    Lexer,
    Parser,
    Syntax,
    Typing,
    Evaluation

  --other-extensions:

  build-depends: 
    base ^>=4.20.2.0,
    array ^>=0.5.8.0,
    directory ^>=1.3.10.1,
    ansi-terminal ^>=1.1.5

  hs-source-dirs:
    app
    src
    programs

  default-language: Haskell2010

  --default-extensions:
